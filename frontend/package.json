{
  "name": "layered-span-studio-frontend",
  "private": true,
  "version": "0.1.1",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "agentation:mcp": "agentation-mcp server",
    "generate:api:schema": "cd ../backend && uv run python scripts/export_openapi.py ../frontend/openapi/layered-span-studio.openapi.json",
    "generate:api:types": "openapi-typescript ./openapi/layered-span-studio.openapi.json -o ./src/generated/openapi.ts",
    "generate:api": "npm run generate:api:schema && npm run generate:api:types"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "openapi-fetch": "^0.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^6.0.1",
    "agentation": "^2.3.3",
    "agentation-mcp": "^1.2.0",
    "jsdom": "^28.1.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
