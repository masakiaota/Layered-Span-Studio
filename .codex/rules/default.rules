prefix_rule(pattern=["uv", "run"], decision="allow")
prefix_rule(pattern=["uv", "add"], decision="allow")

prefix_rule(
  pattern=["python"],
  decision="forbidden",
  justification="Use `uv run ...` for execution and `uv add ...` for dependencies."
)

prefix_rule(
  pattern=["python3"],
  decision="forbidden",
  justification="Use `uv run ...` for execution and `uv add ...` for dependencies."
)

prefix_rule(
  pattern=["python", "-m", "pip"],
  decision="forbidden",
  justification="Use `uv add ...` instead of `python -m pip ...`."
)

prefix_rule(
  pattern=["python3", "-m", "pip"],
  decision="forbidden",
  justification="Use `uv add ...` instead of `python3 -m pip ...`."
)

prefix_rule(
  pattern=["pip"],
  decision="forbidden",
  justification="Use `uv add ...` for dependency management."
)

prefix_rule(
  pattern=["pip3"],
  decision="forbidden",
  justification="Use `uv add ...` for dependency management."
)

prefix_rule(
  pattern=["uv", "pip", "install"],
  decision="forbidden",
  justification="Use `uv add ...` instead of `uv pip install ...`."
)
